{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "group:all"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images set through a GitHub Actions matrix",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "\\bcontainer:\\s*[\"']?(?<depName>[a-z0-9][a-z0-9./_-]*):(?<currentValue>[\\w][\\w.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
