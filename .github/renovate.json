{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:best-practices", "group:all"],
    "packageRules": [
        {
            "matchDepTypes": ["devDependencies", "dev-dependencies", "dev"],
            "rangeStrategy": "auto"
        },
        {
            "matchManagers": "npm",
            "enabled": false
        },
        {
            "matchPackagePrefixes": ["quay.io/"],
            "registryUrls": ["https://quay.io"]
        },
        {
            "datasources": ["docker"],
            "packagePatterns": ["^quay.io/"],
            "enabled": true
        }
    ]
}
